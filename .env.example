# Use the pooled PostgreSQL connection from Neon in production.
DATABASE_URL="postgresql://user:password@host-pooler/database?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate`; on Neon it is the same host without `-pooler`.
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Generate per-user PBKDF2 salts/hashes and a long random session secret.
AUTH_USERS_JSON='[{"username":"person-one","salt":"generated-salt","hash":"generated-pbkdf2-hash"}]'
AUTH_SESSION_SECRET="generate-a-long-random-value"
